# ─────────────────────────────────────────────────────────────────────────────
# Autonomous Accident Detection System – example environment configuration
# Copy this file to .env and fill in your own values.
# ─────────────────────────────────────────────────────────────────────────────

# Set to 'false' to use real hardware (MPU-6050 via I2C, GPS via serial).
# Leave as 'true' for development / CI simulation mode.
SIMULATION_MODE=true

# ── Accident detection thresholds ────────────────────────────────────────────
# Minimum G-force magnitude (in g) that indicates a potential impact.
ACCELEROMETER_THRESHOLD=2.5

# Number of consecutive above-threshold readings required to confirm an accident.
ACCIDENT_CONFIRMATION_COUNT=3

# Sensor polling interval in seconds.
SAMPLE_INTERVAL=0.1

# ── GPS serial settings ───────────────────────────────────────────────────────
GPS_PORT=/dev/ttyAMA0
GPS_BAUDRATE=9600

# ── E-mail alert settings ─────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=your_email@gmail.com
# Use a Gmail App Password (not your main password) when 2-FA is enabled.
SENDER_PASSWORD=your_app_password

# Comma-separated list of recipient e-mail addresses.
EMERGENCY_EMAIL_CONTACTS=contact1@example.com,contact2@example.com

# ── Twilio SMS settings (optional) ────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Comma-separated list of E.164 phone numbers to receive SMS alerts.
EMERGENCY_PHONE_NUMBERS=+0987654321,+1122334455
